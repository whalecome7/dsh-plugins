{
  "name": "dsh-plugin-hello",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal third-party dsh plugin: host route + right-sidebar tab. Used to verify the local plugin loading chain.",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web"
    }
  }
}
